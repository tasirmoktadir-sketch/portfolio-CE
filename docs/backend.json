{
  "entities": {
    "videoProject": {
      "title": "Video Project",
      "description": "Represents a video project in the portfolio.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "The title of the video."
        },
        "description": {
          "type": "string",
          "description": "A short description of the video."
        },
        "youtubeEmbedId": {
          "type": "string",
          "description": "The ID of the YouTube video to embed."
        },
        "category": {
          "type": "string",
          "description": "The category of the video project."
        }
      },
      "required": [
        "title",
        "description",
        "youtubeEmbedId",
        "category"
      ]
    },
    "aboutInfo": {
      "title": "About Information",
      "description": "Content for the About Me page.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "tagline": {
          "type": "string"
        },
        "bio1": {
          "type": "string"
        },
        "bio2": {
          "type": "string"
        },
        "profileImageUrl": {
          "type": "string"
        },
        "profileImageStoragePath": {
          "type": "string"
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "service": {
      "title": "Service",
      "description": "Represents a service offered.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "required": ["title", "description"]
    },
    "testimonial": {
      "title": "Testimonial",
      "description": "Represents a client testimonial.",
      "type": "object",
      "properties": {
        "clientName": {
          "type": "string"
        },
        "quote": {
          "type": "string"
        }
      },
      "required": ["clientName", "quote"]
    }
  },
  "auth": {
    "providers": ["email-password"]
  },
  "firestore": {
    "/videoProjects/{videoProjectId}": {
      "schema": {
        "$ref": "#/backend/entities/videoProject"
      },
      "description": "Stores all the video projects for the portfolio."
    },
    "/siteContent/about": {
      "schema": {
        "$ref": "#/backend/entities/aboutInfo"
      },
      "description": "Stores the content for the About Me page."
    },
    "/services/{serviceId}": {
      "schema": {
        "$ref": "#/backend/entities/service"
      },
      "description": "Stores the list of services offered."
    },
    "/testimonials/{testimonialId}": {
      "schema": {
        "$ref": "#/backend/entities/testimonial"
      },
      "description": "Stores client testimonials."
    }
  }
}
